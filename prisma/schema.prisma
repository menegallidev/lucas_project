generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum TipoPessoa {
  PF
  PJ
}

enum ClientStatus {
  ATIVO
  INATIVO
}

enum InventoryMovementType {
  ENTRADA
  SAIDA
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  cpf          String
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Client {
  id Int @id @default(autoincrement())

  personType TipoPessoa
  name       String
  tradeName  String?
  document   String?    @unique
  stateTaxId String?

  email    String?
  phone1   String
  phone2   String?
  whatsapp String?

  zipCode        String
  street         String
  number         String
  complement     String?
  neighborhood   String
  city           String
  state          String
  referencePoint String?

  paymentTerms String?
  notes        String?

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  agendaEvents AgendaEvent[]

  status    ClientStatus @default(ATIVO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("clients")
}

model Company {
  id        Int     @id @default(autoincrement())
  name      String
  tradeName String?
  document  String? @unique
  email     String?
  phone     String?

  clients   Client[]
  status    ClientStatus @default(ATIVO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("companies")
}

model AgendaEvent {
  id Int @id @default(autoincrement())

  title    String
  startAt  DateTime
  location String?
  notes    String?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agenda_events")
}

model Product {
  id Int @id @default(autoincrement())

  name  String
  price Float
  model String
  notes String?
  status ClientStatus @default(ATIVO)
  stockQuantity Float @default(0)
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  movementType InventoryMovementType
  quantity     Float
  performedAt  DateTime
  notes        String?

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_movements")
}
